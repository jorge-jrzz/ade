// Scene 4: a full request pipeline — Web Client -> API Gateway -> Service -> DB.
external client "Web Client"         { at: (-4.8, 1.8) }
gateway  api    "API Gateway"        { logo: nestjs                       at: (-4.8, -1.3) }
service  proc   "Processing Service" { logo: python      size: 2.8        at: (1.35, -1.3) }
database db     "PostgreSQL"         { logo: postgresql  sublabel: "Primary"  size: 2.8  at: (5.1, -1.3) }

infra "AWS Cloud Infrastructure" {
    logo: aws
    at: (3.15, -0.4)
    size: (7.2, 5.6)
    proc
    db
}

flow "Builders" {
    step 1: client --[HTTPS]--> api
    step 2: api    --[Process Data]--> proc
    step 3: proc   --[SQL]--> db
}
