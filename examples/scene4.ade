// Scene 4: a full request pipeline — Web Client -> API Gateway -> Service -> DB.
external client "Web Client"
gateway  api    "API Gateway"        { logo: nestjs }
service  proc   "Processing Service" { logo: python }
database db     "PostgreSQL"         { logo: postgresql  sublabel: "Primary" }

infra "AWS Cloud Infrastructure" {
    logo: aws
    proc
    db
}

flow "Builders" {
    step 1: client --[HTTPS]--> api
    step 2: api    --[Process Data]--> proc
    step 3: proc   --[SQL]--> db
}
