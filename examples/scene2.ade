// Scene 2: scaling out — add a second web server and a load balancer.
// A timeline animates the change step by step (imperative sub-language); the
// engine re-lays-out automatically as nodes are added, so existing cards slide
// to make room (no manual `move`s).
service  web1 "Web Server"
database db   "Database"

timeline "Scaling" {
    show web1, db
    connect web1 --[Read/Write]--> db curved
    wait

    add service web2 "Web Server 2"
    add service lb   "Load Balancer" { kind: infra }

    connect lb --> web1
    connect lb --> web2
    connect web2 --[Read/Write]--> db curved
    wait
}
